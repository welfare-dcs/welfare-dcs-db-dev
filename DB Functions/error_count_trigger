CREATE OR REPLACE FUNCTION public.error_count_trigger()
 RETURNS trigger
 LANGUAGE plpgsql
AS $function$

begin

    refresh materialized view concurrently public.error_count_1;

    refresh materialized view concurrently public.error_count_2;

    refresh materialized view concurrently public.error_count_3;

    refresh materialized view concurrently public.error_count_5;

   refresh materialized view concurrently public.error_count_6;

   refresh materialized view concurrently public.error_count_7;

   refresh materialized view concurrently public.error_count_9_3;

   refresh materialized view concurrently public.error_count_9_7;

   refresh materialized view concurrently public.error_count_su_4;

   refresh materialized view concurrently public.error_count_es;

   refresh materialized view concurrently public.error_count_es_appeals;

   refresh materialized view concurrently public.error_count_queue;

    return null;

end $function$

