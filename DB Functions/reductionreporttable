CREATE OR REPLACE FUNCTION public.reductionreporttable(_offset integer, _limit integer, _reporttype character varying, _reportmonth character varying, _sortcolumn character varying, _sortorder character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;

declare total int4;

declare offsetValue int4 = 10;

declare globalId12 int4;

declare globalId15 int4;

declare globalId14 int4;

declare globalId8 int4;

declare globalId7 int4;

declare globalId2 int4;



begin



    select g."ruleValue"::int into globalId12 from public.globals g where g."globalId" = 12;

    select g."ruleValue"::int into globalId15 from public.globals g where g."globalId" = 15;

    select g."ruleValue"::int into globalId14 from public.globals g where g."globalId" = 14;

    select g."ruleValue"::int into globalId8 from public.globals g where g."globalId" = 8;

    select g."ruleValue"::int into globalId7 from public.globals g where g."globalId" = 7;

    select g."ruleValue"::int into globalId2 from public.globals g where g."globalId" = 2;



    offsetValue = offsetValue * _offset;



if _offset = 0 then



select count(t1) from

(

select

concat(a4."ApplicantGenId",concat('-',a4."ApplicationSequence")) as "casenumber"

,a4."LastBatchDate"::date

, initcap(a."ApplicantFirstName") as "firstname"

, initcap(a."ApplicantLastName") as "lastname"

, teo.description as "region"

, rc."CountyName" as "county"

, e."CreateDate"::date as "errordate"

, e."FineDate"::date as "reductiondate"

-- , lh."SentDate" as "letterdate",

, a4."ApplicationSignedDate"::date + (globalId12 || ' days')::interval as "notification_date"

, CASE

WHEN a2."AppealAcceptDate"::date is not null THEN 'accepted'

when a2."AppealDenyDate"::date is not null then 'denied'

end as "appealdenied",

CASE

WHEN e."CannotBeCorrected" is not null THEN 'yes'

else 'no'

end as "cannotbecorrected"

from dbo."Applicant" a

join dbo."Application" a4 on a."ApplicantGenId" = a4."ApplicantGenId"

join dbo."MonitoringSequence" ms on a4."ApplicantGenId"  = ms."ApplicantGenId" and a4."ApplicationSequence" = ms."ApplicationSequence"

-- inner join dbo."LetterHistory" lh on ms."ApplicantGenId" = lh."ApplicantGenId" and ms."ApplicationSequence" = lh."ApplicationSequence"

left join dbo."Error" e on ms."MonitoringSequenceGenId" = e."MonitoringSequenceGenId"

inner join dbo."Address" adr on a4."ApplicantGenId" = adr."ApplicantGenId" and  a4."ApplicationSequence" = adr."ApplicationSequence" and adr."addressInd" is true

inner join dbo."ref_County" rc on adr."CountyGenId" = rc."CountyGenId"

inner join dbo."IntakeAgency_County" iac on adr."CountyGenId" = iac."CountyGenId"

inner join public.teligibilityoffice teo on iac.eligibleofficeid = teo.id

left join dbo."Appeals" a2 on e."ErrorGenId" = a2.errorid

left join public.case_by_scanstatus cbs on  cbs.applicationnumber = concat(a4."ApplicantGenId",'-',a4."ApplicationSequence")

where

case when coalesce(cbs.total,0) > 0 and coalesce(a4."ToBeScannedReason",0) in (343) then false else true end

and case when _reporttype = '' then true else teo.id = any(_reporttype ::int[]) end

and a4."IsLimitedEligibility" is not true

and case when _reportmonth = '' then true else to_char(e."FineDate", 'YYYY-MM') = to_char(to_date(_reportmonth, 'dd-mm-yyyy')::timestamp, 'YYYY-MM') end

and a4."ApplicationSignedDate"::date <= current_date - (globalId12 || ' days')::interval

and case

-- 1. A case that has an error marked as cannot be corrected (goes to GAR)

when  e."ErrorCategoryGenId" = 2 and e."CannotBeCorrected" is not null then true

-- 2. A case where an appeal has been denied after 6 days (Days in which a case must be terminated by ES after appeal denial)

when e."ErrorCategoryGenId" = 2 and a2."AppealDate"::date < a2."AppealDenyDate"::date - (globalId15 || ' days')::interval then true

-- 3. A case where an error has been corrected but was corrected after 23 days

when e."ErrorCategoryGenId" = 2 and e.errorstatus is true and (e."ApprovedInd" is false or e."ApprovedInd" is null or e."FixDate" is null) and e."CreateDate"::date < current_date - (globalId8 || ' days')::interval then true

-- 4. A case has been singed by provider but no documents were scanned within 13 (Days in which no documents were not scanned  to notify ES to terminate the case)

when a4."ApplicationSignedDate"::date < current_date - (globalId2 || ' days')::interval and a4."ScanStatusGenId" = 1 then true

-- Days in which documentation has been scanned and not reviewed by an Eligibility Specialist

when a4."ApplicationSignedDate"::date < current_date - (globalId14 || ' days')::interval and a4."ScanStatusGenId" = 2 then true

-- 5. A case in which errors have not been corrected within 13 days (Days in which eligibility errors must be fixed )

-- when (select count(*) from dbo."Error" e where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is null and e."CannotBeCorrected" is null and  e."RemovedByPolicy" is null and e."FixDate" is null and e.errorstatus is true and e."CreateDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 8) || ' days')::interval) > 0 then true

-- 6. A case in which correction was denied, no appeal was created, no termination(Days in which a correction denial may be appealed)

when (select count(a3.*) from dbo."Appeals" a3  where e."MonitoringSequenceGenId" = a3."MonitoringSequenceGenId") = 0 and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is false and a4."TerminationDate" is null then true

-- 7. A case in which errors are outstanding (no fixed date) after 23 days (Days in which a case with critical errors appear on the Preview Payment Reduction report)

-- when (select count(*) from dbo."Error" e where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is null and e."CannotBeCorrected" is null and  e."RemovedByPolicy" is null and e."FixDate" is null and e.errorstatus is true and e."CreateDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 12) || ' days')::interval) > 0 then true

end

group by a4."ApplicantGenId", a4."ApplicationSequence",a."ApplicantFirstName",a."ApplicantLastName",rc."CountyName",teo.description,e."CreateDate"::date,e."FineDate"::date, a4."ApplicationSignedDate"::date, a2."AppealDenyDate"::date, a2."AppealAcceptDate"::date, e."CannotBeCorrected", a4."LastBatchDate"::date

)t1

into total;



else



total = 0;



end if;



select Json_agg(row_to_json(t1)) from (

select

concat(a4."ApplicantGenId",concat('-',a4."ApplicationSequence")) as "casenumber"

,a4."LastBatchDate"::date

, initcap(a."ApplicantFirstName") as "firstname"

, initcap(a."ApplicantLastName") as "lastname"

, teo.description as "region"

, rc."CountyName" as "county"

, e."CreateDate"::date as "errordate"

, e."FineDate"::date as "reductiondate"

-- , lh."SentDate" as "letterdate",

, a4."ApplicationSignedDate"::date + (globalId12 || ' days')::interval as "notification_date"

, CASE

WHEN a2."AppealAcceptDate"::date is not null THEN 'accepted'

when a2."AppealDenyDate"::date is not null then 'denied'

end as "appealdenied",

CASE

WHEN e."CannotBeCorrected" is not null THEN 'yes'

else 'no'

end as "cannotbecorrected"

from dbo."Applicant" a

join dbo."Application" a4 on a."ApplicantGenId" = a4."ApplicantGenId"

join dbo."MonitoringSequence" ms on a4."ApplicantGenId"  = ms."ApplicantGenId" and a4."ApplicationSequence" = ms."ApplicationSequence"

-- inner join dbo."LetterHistory" lh on ms."ApplicantGenId" = lh."ApplicantGenId" and ms."ApplicationSequence" = lh."ApplicationSequence"

left join dbo."Error" e on ms."MonitoringSequenceGenId" = e."MonitoringSequenceGenId"

inner join dbo."Address" adr on a4."ApplicantGenId" = adr."ApplicantGenId" and  a4."ApplicationSequence" = adr."ApplicationSequence" and adr."addressInd" is true

inner join dbo."ref_County" rc on adr."CountyGenId" = rc."CountyGenId"

inner join dbo."IntakeAgency_County" iac on adr."CountyGenId" = iac."CountyGenId"

inner join public.teligibilityoffice teo on iac.eligibleofficeid = teo.id

left join dbo."Appeals" a2 on e."ErrorGenId" = a2.errorid

left join public.case_by_scanstatus cbs on  cbs.applicationnumber = concat(a4."ApplicantGenId",'-',a4."ApplicationSequence")

where

case when coalesce(cbs.total,0) > 0 and coalesce(a4."ToBeScannedReason",0) in (343) then false else true end

and case when _reporttype = '' then true else teo.id = any(_reporttype ::int[]) end

and a4."IsLimitedEligibility" is not true

and case when _reportmonth = '' then true else to_char(e."FineDate", 'YYYY-MM') = to_char(to_date(_reportmonth, 'dd-mm-yyyy')::timestamp, 'YYYY-MM') end

and a4."ApplicationSignedDate"::date <= current_date - (globalId12 || ' days')::interval

and case

-- 1. A case that has an error marked as cannot be corrected (goes to GAR)

when  e."ErrorCategoryGenId" = 2 and e."CannotBeCorrected" is not null then true

-- 2. A case where an appeal has been denied after 6 days (Days in which a case must be terminated by ES after appeal denial)

when e."ErrorCategoryGenId" = 2 and a2."AppealDate"::date < a2."AppealDenyDate"::date - (globalId15 || ' days')::interval then true

-- 3. A case where an error has been corrected but was corrected after 23 days

when e."ErrorCategoryGenId" = 2 and e.errorstatus is true and (e."ApprovedInd" is false or e."ApprovedInd" is null or e."FixDate" is null) and e."CreateDate"::date < current_date - (globalId8 || ' days')::interval then true

-- 4. A case has been singed by provider but no documents were scanned within 13 (Days in which no documents were not scanned  to notify ES to terminate the case)

when a4."ApplicationSignedDate"::date < current_date - (globalId2 || ' days')::interval and a4."ScanStatusGenId" = 1 then true

-- Days in which documentation has been scanned and not reviewed by an Eligibility Specialist

when a4."ApplicationSignedDate"::date < current_date - (globalId14 || ' days')::interval and a4."ScanStatusGenId" = 2 then true

-- 5. A case in which errors have not been corrected within 13 days (Days in which eligibility errors must be fixed )

-- when (select count(*) from dbo."Error" e where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is null and e."CannotBeCorrected" is null and  e."RemovedByPolicy" is null and e."FixDate" is null and e.errorstatus is true and e."CreateDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 8) || ' days')::interval) > 0 then true

-- 6. A case in which correction was denied, no appeal was created, no termination(Days in which a correction denial may be appealed)

when (select count(a3.*) from dbo."Appeals" a3  where e."MonitoringSequenceGenId" = a3."MonitoringSequenceGenId") = 0 and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is false and a4."TerminationDate" is null then true

-- 7. A case in which errors are outstanding (no fixed date) after 23 days (Days in which a case with critical errors appear on the Preview Payment Reduction report)

-- when (select count(*) from dbo."Error" e where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is null and e."CannotBeCorrected" is null and  e."RemovedByPolicy" is null and e."FixDate" is null and e.errorstatus is true and e."CreateDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 12) || ' days')::interval) > 0 then true

end

group by a4."ApplicantGenId", a4."ApplicationSequence",a."ApplicantFirstName",a."ApplicantLastName",rc."CountyName",teo.description,e."CreateDate"::date,e."FineDate"::date, a4."ApplicationSignedDate"::date, a2."AppealDenyDate"::date, a2."AppealAcceptDate"::date, e."CannotBeCorrected", a4."LastBatchDate"::date

order by 

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('casenumber') then a4."ApplicantGenId" end) asc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('casenumber') then a4."ApplicationSequence" end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('casenumber') then a4."ApplicantGenId" end) desc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('casenumber') then a4."ApplicationSequence" end) desc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('firstname') then a."ApplicantFirstName" end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('firstname') then a."ApplicantFirstName" end) desc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('lastname') then a."ApplicantLastName" end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('lastname') then a."ApplicantLastName" end) desc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('region') then teo.description end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('region') then teo.description end) desc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('county') then rc."CountyName" end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('county') then rc."CountyName" end) desc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('errordate') then e."CreateDate"::date end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('errordate') then e."CreateDate"::date end) desc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('reductiondate') then e."FineDate"::date end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('reductiondate') then e."FineDate"::date end) desc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('notification_date') then a4."ApplicationSignedDate"::date + (globalId12 || ' days')::interval  end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('notification_date') then a4."ApplicationSignedDate"::date + (globalId12 || ' days')::interval  end) desc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('appealdenied') then CASE

WHEN a2."AppealAcceptDate"::date is not null THEN 'accepted'

when a2."AppealDenyDate"::date is not null then 'denied'

end end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('appealdenied') then CASE

WHEN a2."AppealAcceptDate"::date is not null THEN 'accepted'

when a2."AppealDenyDate"::date is not null then 'denied'

end end) desc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('cannotbecorrected') then CASE

WHEN e."CannotBeCorrected" is not null THEN 'yes'

else 'no'

end end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('cannotbecorrected') then CASE

WHEN e."CannotBeCorrected" is not null THEN 'yes'

else 'no'

end end) desc,

(case when lower(_sortorder) = lower('asc') and lower(_sortcolumn) = lower('lastbatchdate') then a4."LastBatchDate"::date end) asc,

(case when lower(_sortorder) = lower('desc') and lower(_sortcolumn) = lower('lastbatchdate') then a4."LastBatchDate"::date end) desc

limit _limit

offset offsetValue

)t1 into result;





RETURN COALESCE(json_build_array(json_build_object('totalCount',total,'data',coalesce(result,'[]'))),'[]');



 END;

 $function$

