CREATE OR REPLACE FUNCTION public.updateligibilityofficounty(_eligibleofficeid integer, _countycount integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;

DECLARE _id INTEGER;



begin



   update public.teligibilityoffice  set countycount = _countycount where id = _eligibleofficeid;





RETURN COALESCE(result,'[]');



 END;

 $function$

