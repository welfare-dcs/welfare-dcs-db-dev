CREATE OR REPLACE FUNCTION public.removecaseinfo_uat(_startdate date, _enddate date)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE



result json;

i RECORD;

_loopcount int8:=0;

_applicantgenid integer;

_applicationsequenceid integer;

_aisschedulerid uuid;

_id uuid;

_applicationid character varying;



begin



   INSERT INTO public.aisscheduler

(starttime, endtime, totalcount, status)

VALUES('', '', 0, 'Initiated'::character varying) returning id into _aisschedulerid;



--   FOR i IN select a.casenumber, a.caseseqnumber from public.aisschedulerdetails a where a.createdate::date between _startdate::date and _enddate::date and a.casenumber::integer > '305180'::integer group by a.casenumber ,a.caseseqnumber

   FOR i IN select a.casenumber, a.caseseqnumber, a.id  from public.aisschedulerdetails a where a.status = 'improgress_1' group by a.casenumber ,a.caseseqnumber, a.id 

  loop



      _applicantgenid:= i.casenumber::integer;

      _applicationsequenceid:= i.caseseqnumber::integer;

      _applicationid:= concat(_applicantgenid,'-',_applicationsequenceid);

      _loopcount:= _loopcount+1;

      _id:= i.id::uuid;

   RAISE NOTICE '_loopcount %', _loopcount;

    RAISE NOTICE '_applicantgenid %', _applicantgenid;

    RAISE NOTICE '_applicationsequenceid %', _applicationsequenceid;

    RAISE NOTICE '_applicationid %', _applicationid;

    RAISE NOTICE '_aisschedulerid %', _aisschedulerid;

   RAISE NOTICE '_id %', _id;

   RAISE NOTICE '****************';



    --character varying _barcode = concat

 -- Remove Index

 delete from dbo."ScannedDocsIndex" sdi where split_part(sdi."BarCode",'-',1) = _applicantgenid::character varying and split_part(sdi."BarCode",'-',2) = _applicationsequenceid::character varying;



 -- User Document

 delete from userdocument u2 where u2.documentid in (select s2.id from scannedimage s2  where s2.applicationid = _applicationid);



 --Scanned Image

 delete from scannedimagelist s3 where s3.scannedimageuid in (select s2.id from scannedimage s2  where s2.applicationid = _applicationid);



 --Scanned Image list

 delete  from scannedimage s2  where s2.applicationid = _applicationid;





 -- Document page



 delete from dbo."DocumentPage" dp2 where dp2."DocumentPageGenId" in (

 select  dp."DocumentPageGenId"

 from dbo."ApplicantBatch" ab

 join dbo."Document" d on ab."ApplicantBatchGenId" = d."ApplicantBatchGenId"

 join dbo."DocumentPage" dp on d."DocumentGenId" = dp."DocumentGenId"

 where ab."ApplicantGenId" = _applicantgenid

 and ab."ApplicationSequence" = _applicationsequenceid);



 -- Document type

 delete from dbo."Document_DocumentType" dp2 where dp2."DocumentDocumentTypeGenId" in (

 select

 ddt."DocumentDocumentTypeGenId"

 from dbo."ApplicantBatch" ab

 join dbo."Document" d on ab."ApplicantBatchGenId" = d."ApplicantBatchGenId"

 join dbo."DocumentPage" dp on d."DocumentGenId" = dp."DocumentGenId"

 join dbo."DocumentBatch" db on ab."DocumentBatchGenId" = db."DocumentBatchGenId"

 join dbo."Document_DocumentType" ddt on d."DocumentGenId" = ddt."DocumentGenId"

 where ab."ApplicantGenId" = _applicantgenid

 and ab."ApplicationSequence" = _applicationsequenceid);





 -- Document



 delete  from dbo."Document" d2 where d2."DocumentGenId" in (

 select

 d."DocumentGenId"

 from dbo."ApplicantBatch" ab

 join dbo."Document" d on ab."ApplicantBatchGenId" = d."ApplicantBatchGenId"

 where ab."ApplicantGenId" = _applicantgenid

 and ab."ApplicationSequence" = _applicationsequenceid);



 -- Application Batch



 delete from dbo."ApplicantBatch" ab where ab."ApplicantGenId" = _applicantgenid

 and ab."ApplicationSequence" = _applicationsequenceid;



-- Below are the error



-- Appeal table

 delete from dbo."Appeals" where errorid in (select e."ErrorGenId" from dbo."MonitoringSequence" ms

 inner join dbo."Error" e on ms."MonitoringSequenceGenId"  = e."MonitoringSequenceGenId"

 where ms."ApplicantGenId" = _applicantgenid and ms."ApplicationSequence" = _applicationsequenceid);



 -- Error Table

 delete from dbo."Error" er where er."MonitoringSequenceGenId" in (select "MonitoringSequenceGenId" from dbo."MonitoringSequence" ms where ms."ApplicantGenId" = _applicantgenid and ms."ApplicationSequence" = _applicationsequenceid);



 -- Monitor Squence Table

 delete  from dbo."MonitoringSequence" ms where ms."ApplicantGenId" = _applicantgenid and ms."ApplicationSequence" = _applicationsequenceid;



 -- Below are the applicant related table



 -- TRANSITIONALCARES

 delete from public."TRANSITIONALCARES" tc where tc."IndividualGenId" in (select f."IndividualGenId"  from dbo."Family" f where f."ApplicantGenId" = _applicantgenid and f."ApplicationSequence" = _applicationsequenceid);



 -- ANNUALIZEDINCOMES

 delete from public."ANNUALIZEDINCOMES" a where a."ApplicantGenId" = _applicantgenid;



 -- Individual

 delete from dbo."Individual" where "IndividualGenId" in (select f."IndividualGenId"  from dbo."Family" f where f."ApplicantGenId" = _applicantgenid and f."ApplicationSequence" = _applicationsequenceid);



 -- FamilyIncome

 delete from dbo."FamilyIncome" fi where fi."ApplicantGenId" = _applicantgenid and fi."ApplicationSequence" = _applicationsequenceid;



 -- Family

 delete from dbo."Family" f where f."ApplicantGenId" = _applicantgenid and f."ApplicationSequence" = _applicationsequenceid;



 -- Address

 delete from dbo."Address" where "ApplicantGenId" = _applicantgenid and "ApplicationSequence" = _applicationsequenceid;



 -- Application

 delete from dbo."Application" a where a."ApplicantGenId" = _applicantgenid and a."ApplicationSequence" = _applicationsequenceid;



 -- Applicant

 delete from dbo."Applicant" where "ApplicantGenId" = _applicantgenid;



--      INSERT INTO public.aisschedulerdetails (aisschedulerid, casenumber, caseseqnumber, status, attempt) VALUES(_aisschedulerid, _applicantgenid::character varying, _applicationsequenceid, 'improgress_1'::character varying, 0);



  END LOOP;



RETURN COALESCE(result,'[]');

end;

$function$

