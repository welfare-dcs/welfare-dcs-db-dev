CREATE OR REPLACE FUNCTION public.caserepaymenterror()
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;

begin



select Json_agg(row_to_json(t)) from (

SELECT iac."IntakeAgencyCode",sum(rr."Amount") as "amount",to_char(e."CreateDate" , 'YYYY-MM') as "month"

FROM dbo."RepaymentRequest" rr 

inner join dbo."MonitoringSequence" ms ON ms."ApplicantGenId" = rr."ApplicantGenId" and ms."ApplicationSequence" = rr."ApplicationSequence" 

inner join dbo."Error" e on e."MonitoringSequenceGenId" = ms."MonitoringSequenceGenId" 

inner join dbo."Address" a on rr."ApplicantGenId" = a."ApplicantGenId" 

inner join dbo."IntakeAgency_County" iac on a."CountyGenId" = iac."CountyGenId" 

where 

rr."Amount" > 0

and e."CreateDate"::date > '2012-12-01'

and e."CreateDate"::date <= '2013-06-01' 

group by iac."IntakeAgencyCode",to_char(e."CreateDate" , 'YYYY-MM')

order by month asc

)t  into result;    

    

RETURN COALESCE(result,'[]');



 END;

 $function$

