CREATE OR REPLACE FUNCTION public.addcounty(_eligibleofficeid integer, _countygenid integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;

declare intakecode character varying;

begin



   --intakecode := 'AA';

   select t.description from public.teligibilityoffice t where t.id = _eligibleofficeid into intakecode;

   

insert into dbo."IntakeAgency_County"   ("IntakeAgencyCode", "CountyGenId",eligibleofficeid)VALUES(intakecode ,_countygenid,_eligibleofficeid );



RETURN COALESCE(json_build_array(json_build_object(

'data',coalesce(result,'[]')

)),'[]');







 END;



 $function$

