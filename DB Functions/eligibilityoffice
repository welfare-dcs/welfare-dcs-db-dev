CREATE OR REPLACE FUNCTION public.eligibilityoffice()
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;



begin



select Json_agg(row_to_json(t1)) from (

select t.description as "lable",t.id as "id" from public.teligibilityoffice t where t.status = 'A'

)t1 into result;



RETURN COALESCE(result,'[]');



 END;

 $function$

