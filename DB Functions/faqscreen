CREATE OR REPLACE FUNCTION public.faqscreen(_id integer DEFAULT 0)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;



begin



select Json_agg(row_to_json(t1)) from (

select 

f.*

, (select Json_agg(row_to_json(t2)) from(

select f2.*,

(

array(

select f3.title from public.faqcategory f3 

where 

string_to_array(f3.id::character varying ,',') && string_to_array(f2.category,',')

and f3.status is true

)

) as "categories"

from public.faq f2 

where 

string_to_array(f2.category,',') && string_to_array(f.id::character varying,',') 

and f2.status is true

order by f2."order" asc, f."UpdateDate" desc

)t2 ) as "details" 

from public.faqcategory f 

where 

case when _id = 0 then true else _id = f.id end 

and f.status is true

order by f."order" asc, f."UpdateDate" desc

)t1 into result;



RETURN COALESCE(result,'[]');



 END;

 $function$

