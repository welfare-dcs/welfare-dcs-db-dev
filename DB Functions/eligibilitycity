CREATE OR REPLACE FUNCTION public.eligibilitycity()
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;



begin



select Json_agg(row_to_json(t1)) from (

select rc.city as "label", rc.city_id as "id"  from dbo.ref_city rc 

)t1 into result;



RETURN COALESCE(result,'[]');



 END;

 $function$

