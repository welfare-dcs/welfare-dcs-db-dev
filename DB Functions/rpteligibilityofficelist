CREATE OR REPLACE FUNCTION public.rpteligibilityofficelist(_offset integer, _limit integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;

declare total int4;

declare offsetValue int4 = 10;



begin

   offsetValue = offsetValue * _offset;



if _offset = 0 then



SELECT count(*) FROM public.teligibilityoffice into total;



else 



total = 0;



end if;



select Json_agg(row_to_json(t1)) from (SELECT A.id,

A.eligibilityofficename,A.description,A.status,A.createdby,

A.usercount as "member",

A.countycount as "county"

FROM public.teligibilityoffice A order by a.eligibilityofficename asc)t1 into result;





RETURN COALESCE(json_build_array(json_build_object(

'totalCount',total,

'data',coalesce(result,'[]')

)),'[]');







 END;



 $function$

