a3."AppealDenyDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 10) || ' days')::interval

) > 0 then true

-- 3. A case where an error has been corrected but was corrected after 23 days

when a2."ScanStatusGenId" = 4 and (select count(*) from dbo."Error" e

where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e.errorstatus is true and (e."ApprovedInd" is true or e."CannotBeCorrected" is not null or e."RemovedByPolicy" is not null or e."FixDate" is not null)

and e."CreateDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 11) || ' days')::interval

) > 0 then true

-- 4. A case has been singed by provider but no documents were scanned within 13 (Days in which no documents were not scanned  to notify ES to terminate the case)

when a2."ScanStatusGenId" = 4 and a2."ApplicationSignedDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 2) || ' days')::interval then true

-- 5. A case in which errors have not been corrected within 13 days (Days in which eligibility errors must be fixed )

when a2."ScanStatusGenId" = 4 and (select count(*) from dbo."Error" e

where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and

e."ApprovedInd" is null and e."CannotBeCorrected" is null and  e."RemovedByPolicy" is null and e."FixDate" is null and e.errorstatus is true

and e."CreateDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 8) || ' days')::interval

) > 0 then true

-- 6. A case in which correction was denied, no appeal was created, no termination(Days in which a correction denial may be appealed)

when a2."ScanStatusGenId" = 4 and (select count(*) from dbo."Error" e inner join dbo."Appeals" a3  on ms."MonitoringSequenceGenId" = a3."MonitoringSequenceGenId"

where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is false) > 0 then true

-- 7. A case in which errors are outstanding (no fixed date) after 23 days (Days in which a case with critical errors appear on the Preview Payment Reduction report)

when a2."ScanStatusGenId" = 4 and (select count(*) from dbo."Error" e

where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and

e."ApprovedInd" is null and e."CannotBeCorrected" is null and  e."RemovedByPolicy" is null and e."FixDate" is null and e.errorstatus is true

and e."CreateDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 11) || ' days')::interval

) > 0 then true

-- 1. A case that has an error marked as cannot be corrected (goes to GAR)

when a2."ScanStatusGenId" = 9 and (select count(*) from dbo."Error" e where e."MonitoringSequenceGenId" = ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e."CannotBeCorrected" is not null) > 0 then true

-- 2. A case where an appeal has been denied after 6 days (Days in which a case must be terminated by ES after appeal denial)

when a2."ScanStatusGenId" = 9 and (select count(*) from dbo."Error" e inner join dbo."Appeals" a3  on ms."MonitoringSequenceGenId" = a3."MonitoringSequenceGenId"

where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and

a3."AppealDenyDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 10) || ' days')::interval

) > 0 then true

-- 3. A case where an error has been corrected but was corrected after 23 days

when a2."ScanStatusGenId" = 9 and (select count(*) from dbo."Error" e

where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e.errorstatus is true and (e."ApprovedInd" is not true or e."CannotBeCorrected" is not null or e."RemovedByPolicy" is not null or e."FixDate" is not null)

and e."CreateDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 12) || ' days')::interval

) > 0 then true

-- 4. A case has been singed by provider but no documents were scanned within 13 (Days in which no documents were not scanned  to notify ES to terminate the case)

when a2."ScanStatusGenId" = 9 and a2."ApplicationSignedDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 2) || ' days')::interval then true

-- 5. A case in which errors have not been corrected within 13 days (Days in which eligibility errors must be fixed )

when a2."ScanStatusGenId" = 9 and (select count(*) from dbo."Error" e

where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and

e."ApprovedInd" is null and e."CannotBeCorrected" is null and  e."RemovedByPolicy" is null and e."FixDate" is null and e.errorstatus is true

and e."CreateDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 8) || ' days')::interval

) > 0 then true

-- 6. A case in which correction was denied, no appeal was created, no termination(Days in which a correction denial may be appealed)

when a2."ScanStatusGenId" = 9 and (select count(*) from dbo."Error" e inner join dbo."Appeals" a3  on ms."MonitoringSequenceGenId" = a3."MonitoringSequenceGenId"

where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is false) > 0 then true

-- 7. A case in which errors are outstanding (no fixed date) after 23 days (Days in which a case with critical errors appear on the Preview Payment Reduction report)

when a2."ScanStatusGenId" = 9 and (select count(*) from dbo."Error" e

where e."MonitoringSequenceGenId" =  ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and

e."ApprovedInd" is null and e."CannotBeCorrected" is null and  e."RemovedByPolicy" is null and e."FixDate" is null and e.errorstatus is true

and e."CreateDate"::date < current_date - ((select g."ruleValue"::int from public.globals g where g."globalId" = 12) || ' days')::interval

) > 0 then true

end

and a2."TerminationDate" is null

and case when _taskfilter = 'EO QA Review' then

(a2."ScanStatusGenId" = 1 and a2."ApplicationSignedDate" is not null)

or

(a2."ScanStatusGenId" = 4 and

(select count(*) from dbo."Error" e where e."MonitoringSequenceGenId" = ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is not true and e."CannotBeCorrected" is null and e."FixDate" is null and e.errorstatus is true and e."RemovedByPolicy" is null and e."CreateDate" > current_date  - ((select g."ruleValue"::int from public.globals g where g."globalId" = 8) || ' days')::interval) > 0)

when _taskfilter = 'Critical Review' then 

(a2."ScanStatusGenId"  = 1 AND a2."ApplicationSignedDate"::date < CURRENT_DATE - ((select g."ruleValue"::int from public.globals g where g."globalId" = 1) || ' days')::interval)

or 

(a2."ScanStatusGenId" = 2 and a2."ApplicationSignedDate"::date > CURRENT_DATE - ((select g."ruleValue"::int from public.globals g where g."globalId" = 1) || ' days')::interval)

or 

(a2."ScanStatusGenId" = 5)

or

(a2."ScanStatusGenId" = 4 and

(select count(*) from dbo."Error" e where e."MonitoringSequenceGenId" = ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is not true and e."CannotBeCorrected" is null and e."FixDate" is null and e.errorstatus is true and e."RemovedByPolicy" is null and e."CreateDate" > current_date  - ((select g."ruleValue"::int from public.globals g where g."globalId" = 8) || ' days')::interval) > 0)

when _taskfilter = 'Appeal Denial' then

(

select count(*) from dbo."Appeals" a4 join dbo."Error" e2 on a4.errorid = e2."ErrorGenId" where e2."MonitoringSequenceGenId" = ms."MonitoringSequenceGenId" and a4."AppealDenyDate" is not null

) > 0

when _taskfilter = 'Correction Denial' then

a2."ScanStatusGenId" = 4 and (select count(*) from dbo."Error" e where e."MonitoringSequenceGenId" = ms."MonitoringSequenceGenId" and e."ErrorCategoryGenId" = 2 and e."ApprovedInd" is false) > 0

when _taskfilter = 'Payment Reduction Preview' then

a2."ScanStatusGenId" = 4

when _taskfilter = 'Payment Reduction Review - FINAL Report for GAR' then

a2."ScanStatusGenId" = 9

else true end

and case when _intakeagency = '' then true else teo.id = any(_intakeagency ::int[]) end

and case when _county = '' then true else rc."CountyGenId" = any(_county ::int[]) end

group by casenumber,monitorsequencegenid,type,task, a."StateCode",assetovermilliondollar,earliestduedate

order by earliestduedate desc

limit _limit

offset offsetValue

)t1 into result;



end if;



end if;



RETURN COALESCE(json_build_array(json_build_object('totalCount',total,'data',coalesce(result,'[]'))),'[]');



 END;

