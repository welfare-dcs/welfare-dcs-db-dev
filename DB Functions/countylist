CREATE OR REPLACE FUNCTION public.countylist()
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;



begin



select Json_agg(row_to_json(t1)) from (

select rc."CountyName" as "lable",rc."CountyGenId" as "id" ,rc.usercount as "count" from dbo."ref_County" rc 

order by rc."CountyName" asc)t1 into result;



RETURN COALESCE(result,'[]');



 END;

 $function$

