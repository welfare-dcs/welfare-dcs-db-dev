CREATE OR REPLACE FUNCTION public.prioritycasetype()
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;



begin



select Json_agg(row_to_json(t1)) from (

select 

rp."PriorityDescription" as "lable"

, rp."PriorityGenId" as "id" 

from dbo."ref_Priority" rp where rp."PriorityGenId" in (1,3,4,9) 

)t1 into result;



RETURN COALESCE(result,'[]');



 END;

 $function$

