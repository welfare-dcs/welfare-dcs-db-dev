CREATE OR REPLACE FUNCTION public.aisreportgetscannedimages(_imagegenid integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;



begin



select Json_agg(row_to_json(t1)) from (

select 

dp."DocumentPageGenId" as "ImageGenId"

--, dp."DocumentImage" as "Image"

, coalesce(encode(dp."DocumentImage", 'escape'), dp."DocumentBase64Image")  as "Image"

from dbo."DocumentPage" dp 

where dp."DocumentPageGenId"  = _imagegenid

)t1 into result;



RETURN COALESCE(result,'[]');



 END;

 $function$

