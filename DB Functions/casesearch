and case when _firstname = '' then true else lower(a."ApplicantFirstName") like lower(concat('%',concat(_firstname,'%'))) end

and case when _lastname = '' then true else lower(a."ApplicantLastName") like lower(concat('%',concat(_lastname,'%'))) end

