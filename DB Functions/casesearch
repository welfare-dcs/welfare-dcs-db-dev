-- and f."ApplicantRelationshipGenId" in (1)

and f."ApplicantInd" is true

group by casenumber,firstname,lastname,address,rid,a."ApplicantGenId",a2."ApplicationSequence",a2."ApplicantGenId"

limit _limit

offset offsetValue

)t1 into result;



