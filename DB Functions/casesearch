else concat(a."ApplicantGenId",concat('-',a2."ApplicationSequence")) = concat(_applicationGenId,concat('-',_applicationSequence))  end

and case when _firstname = '' then true else lower(a."ApplicantFirstName") like lower(concat('%',concat(_firstname,'%'))) end

and case when _lastname = '' then true else lower(a."ApplicantLastName") like lower(concat('%',concat(_lastname,'%'))) end

and case when _address = '' then true else lower(adr."AddressLine1") = lower(_address) end

and case when _county = '' then true else rc."CountyGenId" = _county::int end

and case when _ridnumber = '' then true else i."RIDNumber" = _ridnumber::bigint end

and case

when _applicationstartdate != '' and _applicationenddate = '' then a2."SubsidyBeginDate"::date = to_date(_applicationstartdate, 'dd-mm-yyyy')

when _applicationstartdate = '' and _applicationenddate != '' then a2."SubsidyEndDate"::date = to_date(_applicationenddate, 'dd-mm-yyyy')

when _applicationstartdate != '' and _applicationenddate != '' then

