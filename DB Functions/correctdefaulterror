CREATE OR REPLACE FUNCTION public.correctdefaulterror(_monitoringsequencegenid integer)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



DECLARE result json;



begin



   /*

   update dbo."Error" set "FixDate"=now(), "UpdateDate"=now(), "UpdatedBy"=0, "RemovedByPolicy"=now(), "CannotBeCorrected"=now(),

"Comment"='Error Unmarked By OCR.', "OcrMarked"='Y', errorstatus=false

where "ErrorTypeGenId"=_errortypegenid and  "ErrorGenId"=_errorgenid and errorstatus=true;

*/

   update dbo."Error" set  "UpdateDate"=now(), "UpdatedBy"=0, 

   --"FixDate"=now(),"RemovedByPolicy"=now(), "CannotBeCorrected"=now(),

"Comment"='Error Unmarked By OCR.', "OcrMarked"='Y', errorstatus=false

where errorstatus=true and "MonitoringSequenceGenId" = _monitoringsequencegenid and "ErrorTypeGenId" in (92,90,61,34,89,37,39,64,87,66,54,43,44);



RETURN COALESCE(json_build_array(json_build_object(

'data',coalesce(result,'[]')

)),'[]');



 END;

 $function$

