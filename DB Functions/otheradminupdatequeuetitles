CREATE OR REPLACE FUNCTION public.otheradminupdatequeuetitles(_casenumber character varying, _intakeagency character varying, _casepriority character varying, _startdate character varying, _enddate character varying, _reviewby character varying, _qaindicator character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



declare total int4;



begin



select

count(t)

from

(

select

concat(a2."ApplicantGenId",'-',a2."ApplicationSequence") as "casenumber"

, concat(initcap(a."ApplicantFirstName"),' ',initcap(a."ApplicantLastName")) as "applicantname"

, a2."ApplicationSignedDate" as "applicationdate"

, a2."ApplicationCompleteDate" as "completeddate"

, teo.description as "eligibilityoffice"

, rp."PriorityDescription" as "casepriority"

, ms."ReviewedDate" as "reviewed_date"

, ms."ReviewedBy" --(select concat(f1.lastname ,' ',f1.firstname) from public.fssauser f1 where ms."ReviewedBy" = f1.id) as "reviewed_by"

--,fsu.firstname,fsu.lastname

from dbo."Applicant" a

join dbo."Application" a2 on a."ApplicantGenId" = a2."ApplicantGenId" and case when _startdate = '' and _enddate = '' then true else a2."ApplicationSignedDate"::date between to_date(_startdate, 'dd-mm-yyyy') and to_date(_enddate, 'dd-mm-yyyy') end and a2."TerminationDate" is null and a2."IsLimitedEligibility" is not true and case when _casenumber = '' then true else concat(a2."ApplicantGenId",'-',a2."ApplicationSequence") = _casenumber end

left join dbo."MonitoringSequence" ms on ms."ApplicantGenId" = a2."ApplicantGenId" and ms."ApplicationSequence" = a2."ApplicationSequence"

inner join dbo."Family" f on a2."ApplicantGenId" = f."ApplicantGenId" and a2."ApplicationSequence" = f."ApplicationSequence" and f."ApplicantInd" is true

--left join dbo."ReviewLock" r1 on  r1."ApplicantGenId" = a."ApplicantGenId"

--left join dbo."ReviewHistory" rh on rh."ReviewHistoryGenId" = r1."ReviewHistoryGenId"

--left join fssauser fsu on rh."UserGenId" = fsu.id

left join dbo."ref_Priority" rp on f."PriorityGenId" = rp."PriorityGenId"

--left join dbo."Error" e on ms."MonitoringSequenceGenId" = e."MonitoringSequenceGenId"

join dbo."Address" a3 on a2."ApplicantGenId" = a3."ApplicantGenId" and a2."ApplicationSequence" = a3."ApplicationSequence" and a3."addressInd" is true

left join dbo."ref_County" rc on a3."CountyGenId" = rc."CountyGenId"

left join dbo."IntakeAgency_County" iac on a3."CountyGenId" = iac."CountyGenId"

left join public.teligibilityoffice teo on iac.eligibleofficeid = teo.id

left join dbo."ref_ScanStatus" rss on a2."ScanStatusGenId" = rss."ScanStatusGenId"

left join public.case_by_scanstatus cbs on  cbs.applicationnumber = concat(a2."ApplicantGenId",'-',a2."ApplicationSequence")

where

case when coalesce(cbs.total,0) > 0 and coalesce(a2."ToBeScannedReason",0) in (343) then true else false end

--and case when _casenumber = '' then true else concat(a2."ApplicantGenId",'-',a2."ApplicationSequence") = _casenumber end

and case when _intakeagency = '' then true else teo.id = any(_intakeagency ::int[]) end

and case when _casepriority = '' then true else rp."PriorityGenId" = any(_casepriority::int[]) end

and case when _reviewby = '' then true else ms."ReviewedBy" = any(_reviewby::int[]) end

and case when _qaindicator = '' then true else a2.qa_review_indicator = any(_qaindicator::boolean[]) end

--and case when _startdate = '' and _enddate = '' then true else case when _startdate = '' and _enddate = '' then true else a2."ApplicationSignedDate"::date between to_date(_startdate, 'dd-mm-yyyy') and to_date(_enddate, 'dd-mm-yyyy') end end

group by a."ApplicantFirstName",a."ApplicantLastName",a2."ApplicationSignedDate",

a2."ApplicationCompleteDate",teo.description,rp."PriorityDescription",

ms."ReviewedDate", a2."ApplicantGenId",a2."ApplicationSequence",

--fsu.firstname,fsu.lastname,

ms."ReviewedBy"

)t

into total;







RETURN COALESCE(json_build_array(json_build_object('totalcases',coalesce(total,'0'))),'[]');



 END;

 $function$

