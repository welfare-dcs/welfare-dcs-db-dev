count(t)

from

(

select

concat(a."ApplicantGenId",concat('-',a2."ApplicationSequence")) as "casenumber"

, concat(initcap(a."ApplicantFirstName")

, concat(' ',initcap(a."ApplicantLastName")))  as "applicantname"

, rc."CountyName" as "countyname"

, teo.description as "eligibilityoffice"

, et."Error" as "errortype"

, a2."ApplicationSignedDate" as "signaturedate"

, ms."ReviewedDate" as "reviewdate"

, f.username as "eligiblityspecialist"

, DATE_PART('day',CURRENT_DATE::timestamp - ms."ReviewedDate"::timestamp)::integer as "daysuncorrected"

, e."Comment" as "monitorerrornotes"

from

dbo."Applicant" a

left join dbo."Application" a2 on a2."ApplicantGenId" = a."ApplicantGenId"

inner join dbo."MonitoringSequence" ms on a."ApplicantGenId" = ms."ApplicantGenId"

inner join dbo."Error" e on ms."MonitoringSequenceGenId" = e."MonitoringSequenceGenId"

inner join dbo."ErrorType" et on e."ErrorTypeGenId" = et."ErrorTypeGenId"

left outer join dbo."ref_ErrorCategory" rec on e."ErrorCategoryGenId" = rec."ErrorCategoryGenId"

inner join dbo."Address" adr on a2."ApplicantGenId" = adr."ApplicantGenId" and  a2."ApplicationSequence" = adr."ApplicationSequence" and adr."addressInd" is true

inner join dbo."ref_County" rc on adr."CountyGenId" = rc."CountyGenId"

inner join dbo."IntakeAgency_County" iac on adr."CountyGenId" = iac."CountyGenId"

inner join public.teligibilityoffice teo on iac.eligibleofficeid = teo.id

left join public.fssauser f on e."CreatedBy" = f.id

where rec."ErrorCategoryDescription" is not null

and rec."IsAdminInd" = true

and ms."MonitoringSequenceGenId" is not null

-- and ms."ReviewedDate" is not null

and e."ErrorGenId" is not null

and e."ErrorCategoryGenId" = 1

and a2."IsLimitedEligibility" is not true

