and case when _eligibilityoffice ='' then true else teo.id = any(_eligibilityoffice::int[]) end

and case when _startdate = '' and _enddate = '' then true else e."CreateDate"::date between to_date(_startdate, 'dd-mm-yyyy') and  to_date(_enddate, 'dd-mm-yyyy') end

group by casenumber,applicantname,countyname,eligibilityoffice,errortype,signaturedate,reviewdate,eligiblityspecialist,daysuncorrected,monitorerrornotes

