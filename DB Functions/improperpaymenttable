left join dbo."RepaymentRequest" rr on a."ApplicantGenId" = rr."ApplicantGenId" and a."ApplicationSequence" = rr."ApplicationSequence"

-- left join dbo."ref_FundingSource" rfs on a."FundingSourceGenId" = rfs."FundingSourceGenId"

left join dbo."Family" f on a."ApplicantGenId" = f."ApplicantGenId" and a."ApplicationSequence" = f."ApplicationSequence"

left join dbo."Individual" i on f."IndividualGenId" = i."IndividualGenId"

left join dbo."ref_County" rc on a2."CountyGenId" = rc."CountyGenId"

left join dbo."IntakeAgency_County" iac on a2."CountyGenId" = iac."CountyGenId"

left join public.teligibilityoffice teo on iac.eligibleofficeid = teo.id

left join public.aisvoucher a3 on a."ApplicantGenId" = a3."ApplicantGenId" and a."ApplicationSequence" = a3."ApplicationSequence"

left join dbo."ref_FundingSource" rfs on a3."RefFundingSourceGenID" = rfs."FundingSourceCode"

where

case when _intakeagency = '' then true else teo.id = any(_intakeagency ::int[]) end

and case when _county = '' then true else rc."CountyGenId" = any(_county ::int[]) end

and case when _fundingsource = '' then true else rfs."FundingSourceCode" = _fundingsource end

and case when _startdate = '' and _enddate = '' then true else a."ApplicationSignedDate"::date between to_date(_startdate, 'dd-mm-yyyy') and  to_date(_enddate, 'dd-mm-yyyy') end

group by a3."VoucherGenId", a3."VoucherBeginDate", concat(initcap(a2."ApplicantFirstName"),concat(' ',initcap(a2."ApplicantLastName"))), a3."ChargeFrequencyCode", rpl."PovertyLevelGenId", a3."SubsidyAmount", a3."CoPayAmount", rr."DatePaid", a3."ChargeAmount", rfs."FundingSourceCode", i."DateOfBirth", a."PovertyLevelGenId" 

order by ageofchild desc

limit _limit

offset offsetValue

)t1 into result;



end if;



end if;



RETURN COALESCE(json_build_array(json_build_object('totalCount',total,'data',coalesce(result,'[]'))),'[]');



 END;

 $function$

