CREATE OR REPLACE FUNCTION public.dashboardtiles(_intakeagency character varying, _county character varying)
 RETURNS json
 LANGUAGE plpgsql
AS $function$



declare pendingaction int4;

declare completed int4;

declare improgress int4;

declare critical int4;

declare opencase int4;



begin



select count(a.*) from dbo."Application" a

join dbo."Applicant" a2 on a."ApplicantGenId" = a2."ApplicantGenId"

join dbo."ref_County" rc on a2."CountyGenId" = rc."CountyGenId"

join dbo."IntakeAgency_County" iac on a2."CountyGenId" = iac."CountyGenId"

join public.teligibilityoffice teo on iac.eligibleofficeid = teo.id

join dbo."MonitoringSequence" ms on a."ApplicantGenId" = ms."ApplicantGenId" and a."ApplicationSequence" = ms."ApplicationSequence"

join dbo."Error" e on ms."MonitoringSequenceGenId" = e."MonitoringSequenceGenId"

where a."ScanStatusGenId" in (4)

and e."ErrorCategoryGenId" = 2

and case when _intakeagency = '' then true else teo.id = any(_intakeagency ::int[]) end

and case when _county = '' then true else rc."CountyGenId" = any(_county ::int[]) end

and a."IsLimitedEligibility" is not true into critical;



select count(a.*) from dbo."Application" a

join dbo."Applicant" a2 on a."ApplicantGenId" = a2."ApplicantGenId"

join dbo."ref_County" rc on a2."CountyGenId" = rc."CountyGenId"

join dbo."IntakeAgency_County" iac on a2."CountyGenId" = iac."CountyGenId"

join public.teligibilityoffice teo on iac.eligibleofficeid = teo.id

join dbo."MonitoringSequence" ms on a."ApplicantGenId" = ms."ApplicantGenId" and a."ApplicationSequence" = ms."ApplicationSequence"

join dbo."Error" e on ms."MonitoringSequenceGenId" = e."MonitoringSequenceGenId"

where a."ScanStatusGenId" in (4)

and e."ErrorCategoryGenId" = 2

and e."ApprovedInd" is not true

and e."CannotBeCorrected" is null

and e."RemovedByPolicy" is null

and e.errorstatus is true

and case when _intakeagency = '' then true else teo.id = any(_intakeagency ::int[]) end

and case when _county = '' then true else rc."CountyGenId" = any(_county ::int[]) end

and a."IsLimitedEligibility" is not true into pendingaction;



select count(t1.*) from

(

select

concat(a2."ApplicantGenId",'-',a2."ApplicationSequence") as "applicationnumber"

, concat(a."ApplicantFirstName",' ',a."ApplicantLastName") as "applicantname"

, a2."CreateDate" as "receiveddate"

, rc."CountyName" as "countyname"

, rp."PriorityDescription" as "type"

from dbo."Applicant" a

join dbo."Application" a2 on a."ApplicantGenId" = a2."ApplicantGenId"

left join dbo."ref_County" rc on a."CountyGenId" = rc."CountyGenId"

left join dbo."IntakeAgency_County" iac on a."CountyGenId" = iac."CountyGenId"

left join public.teligibilityoffice teo on iac.eligibleofficeid = teo.id

join dbo."Family" f on a."ApplicantGenId" = f."ApplicantGenId" and a2."ApplicationSequence" = f."ApplicationSequence" and f."ApplicantInd" is true

join dbo."ref_Priority" rp on f."PriorityGenId" = rp."PriorityGenId"

left join public.case_by_scanstatus cbs on cbs.applicationnumber = concat(a2."ApplicantGenId",'-',a2."ApplicationSequence")

where

a2."ScanStatusGenId" in (2,4,5)

and case when coalesce(cbs.total,0) > 0 and coalesce(a2."ToBeScannedReason",0) in (343) then false else true end

and f."HasJobSearch" is not true

and a2."IsLimitedEligibility" is not true

and case when _intakeagency = '' then true else teo.id = any(_intakeagency ::int[]) end

and case when _county = '' then true else rc."CountyGenId" = any(_county ::int[]) end

-- and case when (select count(*) from public.ais_applicationversionscandetail where "CaseNumber"= a2."ApplicantGenId" and "CaseSeqNumber"  = a2."ApplicationSequence" and "ScanStatusCode" in (279,282,3,9)) > 0 and coalesce(a2."ToBeScannedReason",0) in (343) then false else true end

and a2."ApplicationSignedDate"::date between '10-01-2018'::date and  current_date

group by a2."ApplicantGenId" ,a2."ApplicationSequence" ,a."ApplicantFirstName" ,a."ApplicantGenId" ,a."ApplicantLastName" ,a2."CreateDate" ,rc."CountyName" ,rp."PriorityDescription"

)t1

into improgress;



select count(a.*) from dbo."Application" a

join dbo."Applicant" a2 on a."ApplicantGenId" = a2."ApplicantGenId"

join dbo."ref_County" rc on a2."CountyGenId" = rc."CountyGenId"

join dbo."IntakeAgency_County" iac on a2."CountyGenId" = iac."CountyGenId"

join public.teligibilityoffice teo on iac.eligibleofficeid = teo.id

where a."ScanStatusGenId" in (2,4)

and case when _intakeagency = '' then true else teo.id = any(_intakeagency ::int[]) end

and case when _county = '' then true else rc."CountyGenId" = any(_county ::int[]) end

and a."IsLimitedEligibility" is not true into opencase;



select count(t1.*) from

(

select

concat(a2."ApplicantGenId",'-',a2."ApplicationSequence") as "applicationnumber"

, concat(a."ApplicantFirstName",' ',a."ApplicantLastName") as "applicantname"

, a2."CreateDate" as "receiveddate"

, rc."CountyName" as "countyname"

, rp."PriorityDescription" as "type"

from dbo."Applicant" a

join dbo."Application" a2 on a."ApplicantGenId" = a2."ApplicantGenId"

left join dbo."ref_County" rc on a."CountyGenId" = rc."CountyGenId"

left join dbo."IntakeAgency_County" iac on a."CountyGenId" = iac."CountyGenId"

left join public.teligibilityoffice teo on iac.eligibleofficeid = teo.id

join dbo."Family" f on a."ApplicantGenId" = f."ApplicantGenId" and a2."ApplicationSequence" = f."ApplicationSequence" and f."ApplicantInd" is true

join dbo."ref_Priority" rp on f."PriorityGenId" = rp."PriorityGenId"

left join public.case_by_scanstatus cbs on cbs.applicationnumber = concat(a2."ApplicantGenId",'-',a2."ApplicationSequence")

where

a2."ScanStatusGenId" in (3,9)

and case when coalesce(cbs.total,0) > 0 and coalesce(a2."ToBeScannedReason",0) in (343) then false else true end

and f."HasJobSearch" is not true

and a2."IsLimitedEligibility" is not true

and case when _intakeagency = '' then true else teo.id = any(_intakeagency ::int[]) end

and case when _county = '' then true else rc."CountyGenId" = any(_county ::int[]) end

-- and case when (select count(*) from public.ais_applicationversionscandetail where "CaseNumber"= a2."ApplicantGenId" and "CaseSeqNumber"  = a2."ApplicationSequence" and "ScanStatusCode" in (279,282,3,9)) > 0 and coalesce(a2."ToBeScannedReason",0) in (343) then false else true end

group by a2."ApplicantGenId" ,a2."ApplicationSequence" ,a."ApplicantFirstName" ,a."ApplicantGenId" ,a."ApplicantLastName" ,a2."CreateDate" ,rc."CountyName" ,rp."PriorityDescription"

)t1

into completed;



RETURN COALESCE(json_build_array(json_build_object('pendingaction',coalesce(pendingaction,'0'),'completed',coalesce(completed,'0'),'improgress',coalesce(improgress,'0'),'critical',coalesce(critical,'0'),'opencase',coalesce(opencase,'0'))),'[]');



 END;

 $function$

