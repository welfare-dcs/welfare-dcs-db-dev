group by "casenumber", "type", "task", a."StateCode", "assetovermilliondollar", "scanstatus", "earliestduedate",fsu.firstname,fsu.lastname, (select concat(f1.lastname ,' ',f1.firstname) from public.fssauser f1 where ms."ReviewedBy" = f1.id), ms."ReviewedDate"

order by scanstatus desc

limit _limit

offset offsetValue

)t1 into result;



end if;



