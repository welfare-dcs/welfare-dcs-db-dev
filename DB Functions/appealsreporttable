, teo.description as "eligibilityoffice"

, rc."CountyName" as "county"

, a3."AppealAcceptDate" as "appealacceptdate"

, a3."AppealDenyDate" as "appealdenydate"

, a3."AppealDate" as "appealdate"

, case

when a3."AppealAcceptDate" is not null then coalesce(a3."AppealAcceptDate"::date - a3."AppealDate"::date,0)

when a3."AppealDenyDate" is not null then  coalesce(a3."AppealDenyDate"::date - a3."AppealDate"::date,0)

